---
import type { MarkdownHeading } from 'astro';
import { tocHeadings } from '../lib/toc';

interface Props {
  headings: MarkdownHeading[];
}

const entries = tocHeadings(Astro.props.headings);
---

{entries.length > 0 && (
  <nav class="toc" aria-label="Table of contents">
    <p class="muted">contents:</p>
    <ol>
      {entries.map(({ depth, slug, text }) => (
        <li class={`depth-${depth}`}>
          <a href={`#${slug}`}>{text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .toc {
    margin: 0 0 2.5rem;
    padding: 0.75rem 1.5ch;
    border: 1px dashed var(--faint);
  }
  @media (min-width: 640px) {
    .toc {
      padding: 0.75rem 2ch;
    }
  }
  .toc p {
    margin: 0;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Hanging indent: wrapped lines line up with the text, not with the └ marker. */
  .depth-3 {
    padding-left: 4ch;
    text-indent: -2ch;
  }
  .depth-3::before {
    content: '└ ';
    color: var(--muted);
  }
  a {
    text-decoration: none;
  }
</style>
