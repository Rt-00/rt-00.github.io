---
import Command from '../../components/Command.astro';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/content';
import { countTags } from '../../lib/tags';

const tags = countTags(await getPosts());
---

<Base title="tags" description="All tags.">
  <Command cmd="ls tags/" />
  {tags.length === 0 && <p class="muted">total 0</p>}
  <ul>
    {tags.map(({ tag, count }) => (
      <li>
        <span class="muted">{String(count).padStart(3)}</span> <a href={`/tags/${tag}/`}>{tag}</a>
      </li>
    ))}
  </ul>
</Base>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  span {
    white-space: pre;
  }
</style>
