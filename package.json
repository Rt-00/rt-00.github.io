  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.5",
    "shiki": "4.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
